# ---------- Client (exposed to the browser — public web config only) ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA v3 site key registered for Firebase App Check (leave empty to disable in local dev)
VITE_FIREBASE_APPCHECK_SITE_KEY=

# ---------- Server only (Vercel Functions). NEVER prefix with VITE_ ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; newlines may be written as \n
FIREBASE_PRIVATE_KEY=
# Set to true in production once App Check is configured on the client
APPCHECK_ENFORCE=false

# Storage bucket name, e.g. your-project.firebasestorage.app. Needed for public product images AND payment-proof uploads.
FIREBASE_STORAGE_BUCKET=

# Random string (e.g. `openssl rand -hex 32`). Vercel Cron sends it as `Authorization: Bearer <value>` to /api/cron/po-sweep.
# Without it the endpoint refuses every call.
CRON_SECRET=
