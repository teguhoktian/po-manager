# ---------- Client (exposed to the browser — public web config only) ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA v3 site key registered for Firebase App Check (leave empty to disable in local dev)
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Supabase project URL (public value), e.g. https://abcdxyz.supabase.co — same as SUPABASE_URL below
VITE_SUPABASE_URL=

# ---------- Server only (Vercel environment variables). NEVER prefix with VITE_ ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; newlines may be written as \n
FIREBASE_PRIVATE_KEY=
# Set to true in production once App Check is configured on the client
APPCHECK_ENFORCE=false
# Random string protecting /api/cron/po-sweep (Vercel sends it as a Bearer token)
CRON_SECRET=

# Supabase Storage: images. SERVICE_ROLE_KEY is a secret that bypasses all access rules — server only, never in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
